[Desktop Entry]
Encoding=UTF-8
Name=Steam (HDMI-A-1 2k 120Hz LG C1 HDR)
Comment=Run Steam directly in Gamescope
Exec=gamescope-session -r 120 --adaptive-sync -O HDMI-A-1 -W 2560 -H 1440 --hdr-enabled --hdr-itm-enable --hdr-itm-target-nits 750 --hdr-itm-sdr-nits 250 --hdr-sdr-content-nits 250 --sdr-gamut-wideness 0
Type=Application
DesktopNames=gamescope
