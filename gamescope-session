#!/bin/bash
pgrep pipewire | xargs kill 2>/dev/null

pipewire > /dev/null 2>&1 &

if command -v steam-controller-dsu &>/dev/null; then
    steam-controller-dsu &> "$HOME/steam-controller-dsu.log" &
    scdsu_pid=$!
    echo "steam-controller-dsu running as PID $scdsu_pid"
fi

trap '[ -n "$scdsu_pid" ] && kill "$scdsu_pid"' EXIT

# Prefer X11
export PROTON_ENABLE_WAYLAND=0
export QT_QPA_PLATFORM=xcb
export SDL_VIDEODRIVER=x11

# For --xwayland-count
export STEAM_MULTIPLE_XWAYLANDS=1

STEAM_CMD="steam -gamepadui"

dbus-run-session gamescope \
  -e \
  --backend drm \
  --adaptive-sync \
  --hide-cursor-delay 99999 \
  --xwayland-count 2 \
  "$@" \
  -- bash -c "$STEAM_CMD" > "$HOME/gamescope-session.log" 2>&1

pgrep pipewire | xargs kill 2>/dev/null
